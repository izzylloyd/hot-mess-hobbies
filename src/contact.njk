---
layout: base.njk
permalink: contact.html
title: Contact — Hot Mess Hobby Shop
description: Get in touch with Hot Mess Hobby Shop.
---
<section class="hero">
  <div class="container">
    <h1>Get In Touch</h1>
    <p class="lead">Questions about getting messy with us? Ideas for the next hot mess? We want to hear from you!</p>
  </div>
</section>

<section>
  <div class="container">
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
      <input type="hidden" name="form-name" value="contact">
      <p style="display:none;">
        <label>Leave this field blank: <input name="bot-field"></label>
      </p>

      <label for="name">Name</label>
      <input type="text" id="name" name="name" required>

      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>

      <label for="topic">What's this about?</label>
      <input type="text" id="topic" name="topic">

      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" placeholder="question, comment, haiku, etc" required></textarea>

      <div class="text-center" style="margin-top:24px;">
        <button type="submit" class="btn">Send Message</button>
      </div>
    </form>
    <p class="text-center" style="margin-top:24px; opacity:0.7;">
      Prefer email? Reach us directly at
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>.
    </p>
  </div>
</section>
